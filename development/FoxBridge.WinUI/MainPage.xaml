<Page x:Class="FoxBridge_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FoxBridge_WinUI">
    <Page.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="StatisticGoodBrush" Color="#7DDEA5"/>
                <SolidColorBrush x:Key="StatisticWarningBrush" Color="#FFB56B"/>
                <SolidColorBrush x:Key="StatisticBadBrush" Color="#FF8E95"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="StatisticGoodBrush" Color="#087A3D"/>
                <SolidColorBrush x:Key="StatisticWarningBrush" Color="#9A4B00"/>
                <SolidColorBrush x:Key="StatisticBadBrush" Color="#BB2537"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="StatisticGood" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource StatisticGoodBrush}"/></Style>
        <Style x:Key="StatisticWarning" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource StatisticWarningBrush}"/></Style>
        <Style x:Key="StatisticBad" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource StatisticBadBrush}"/></Style>
        <Style x:Key="StatisticNeutral" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></Style>
        <Style x:Key="StatisticCell" TargetType="Border">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="StatisticDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,-20,0"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <SolidColorBrush x:Key="FoxAccent" Color="#FFAA7B"/>
        <Style x:Key="QuotaIndicatorStyle" TargetType="local:QuotaIndicator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:QuotaIndicator">
                        <Viewbox>
                            <Grid Width="104" Height="104">
                                <Path x:Name="Indicator" Stroke="{TemplateBinding Foreground}" StrokeThickness="6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ReadmeText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
      </ResourceDictionary>
    </Page.Resources>
    <NavigationView x:Name="Navigation" PaneDisplayMode="Left" OpenPaneLength="190"
        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsPaneOpen="True"
        IsSettingsVisible="True" SelectionChanged="Navigate">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Подключение" Tag="dashboard" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Статистика" Tag="details"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Журнал" Tag="log"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Readme" Tag="readme"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel Margin="16,0,12,22" Spacing="5">
                <TextBlock Text="FIREFOX VPN" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Локальный мост" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </NavigationView.PaneFooter>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PageRoot" Padding="28,14,28,28" MaxWidth="1200" HorizontalAlignment="Stretch"
                  IsTabStop="True" UseSystemFocusVisuals="False" Background="Transparent"
                  PointerPressed="BackgroundPointerPressed">
                <StackPanel x:Name="Dashboard" Spacing="18">
                    <StackPanel Spacing="6" Margin="0,0,0,6">
                        <TextBlock Text="Подключение" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Выберите маршрут. Подготовьте терминал. Начните работу." Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning"/>
                    <Grid x:Name="ProfileCards" ColumnSpacing="18" RowSpacing="18" SizeChanged="AdaptProfileCards">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="ProfileCard" Style="{StaticResource Card}" MinHeight="176">
                        <StackPanel Spacing="18" VerticalAlignment="Center">
                            <TextBlock Text="Профиль Firefox" FontWeight="SemiBold"/>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProfileBox" PlaceholderText="Поиск профилей…" SelectionChanged="ProfileChanged" HorizontalAlignment="Stretch"/>
                                <Button x:Name="LoadButton" Grid.Column="1" Content="Загрузить профиль" Click="LoadProfile"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuotaCard" Grid.Column="1" Style="{StaticResource Card}" Width="176" Height="176" Padding="16"
                            ToolTipService.ToolTip="Квота Mozilla появится после загрузки профиля">
                        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Осталось" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <Grid Width="104" Height="104">
                                <Ellipse Width="98" Height="98" StrokeThickness="6" Stroke="{ThemeResource ControlStrongFillColorDefaultBrush}"/>
                                <local:QuotaIndicator x:Name="QuotaRing" Width="104" Height="104" Style="{StaticResource QuotaIndicatorStyle}"
                                              Value="0" Maximum="100" Foreground="{StaticResource FoxAccent}"
                                              AutomationProperties.Name="Остаток квоты Mozilla"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1" IsHitTestVisible="False">
                                    <TextBlock x:Name="QuotaValue" Text="…" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="QuotaUnit" Text="Нет данных" FontSize="10" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Grid x:Name="TopCards" ColumnSpacing="18" RowSpacing="18" SizeChanged="AdaptCards">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="ConnectionCard" Style="{StaticResource Card}">
                            <StackPanel Spacing="17">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#929292" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="Не подключено" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Ваш маршрут через Firefox" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Сервер меняется только по вашему выбору" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <ComboBox x:Name="ServerBox" Header="Сервер" PlaceholderText="Сначала загрузите профиль Firefox" SelectionChanged="ServerChanged" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="Локальный HTTP-прокси" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="AddressText" Text="127.0.0.1:8765" FontFamily="Consolas" FontSize="14"/>
                                    </StackPanel>
                                    <NumberBox x:Name="PortBox" Grid.Column="1" Header="Порт" Value="8765" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Hidden" ValueChanged="PortChanged"/>
                                </Grid>
                                <Button x:Name="ConnectButton" Content="Включить прокси" Click="ToggleConnection" HorizontalAlignment="Stretch" Height="44" IsEnabled="False" Style="{ThemeResource AccentButtonStyle}"/>
                                <Button x:Name="RetryButton" Content="Повторить подключение" Click="RetryConnection" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ScoreCard" Grid.Column="1" Style="{StaticResource Card}">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Доверие к IP" FontWeight="SemiBold"/>
                                    <TextBlock Text="NET.COFFEE" FontSize="10" CharacterSpacing="110" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                    <TextBlock x:Name="ScoreText" Text="—" FontSize="64" FontWeight="SemiBold" Foreground="{StaticResource FoxAccent}"/>
                                    <TextBlock Text="/ 100" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                                </StackPanel>
                                <ProgressBar x:Name="ScoreBar" Value="0" Maximum="100" Foreground="{StaticResource FoxAccent}"/>
                                <TextBlock x:Name="ScoreNote" Text="Оценка появится после подключения и проверки выходного IP." Style="{StaticResource Muted}" MinHeight="48"/>
                                <Button x:Name="RefreshStatsButton" Content="Обновить оценку" Click="RefreshStatistics" IsEnabled="False" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Оценка Net.Coffee, не рейтинг Anthropic" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE756;" Foreground="{StaticResource FoxAccent}" FontSize="18"/>
                                <TextBlock Text="Защищённый терминал" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button x:Name="ShellButton" Click="OpenShell" IsEnabled="False" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE756;" FontSize="14"/><TextBlock Text="Открыть защищённый терминал"/></StackPanel>
                            </Button>
                            <TextBlock x:Name="LaunchNote" Text="Включите прокси и дождитесь оценки IP и подготовки часового пояса." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Локальный прокси через Firefox VPN · Неофициальный клиент" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="DetailsPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Статистика соединения" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Активность" FontWeight="SemiBold"/><TextBlock x:Name="ActivityText" Text="Прокси выключен" Style="{StaticResource Muted}"/><TextBlock x:Name="ChannelText" Text="Канал не запущен" Style="{StaticResource Muted}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Последняя проверка" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailsStateText" Text="Данных пока нет. Подключитесь и обновите оценку." Style="{StaticResource Muted}"/>
                            <Grid x:Name="StatisticRows" ColumnSpacing="40" SizeChanged="AdaptStatistics">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="LogPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Журнал" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="События текущего запуска. Токены и содержимое запросов сюда не попадают." Style="{StaticResource Muted}"/>
                    <Border Style="{StaticResource Card}"><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="300" BorderThickness="0" Background="Transparent"/></Border>
                </StackPanel>
                <StackPanel x:Name="ReadmePanel" Spacing="18" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Readme" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Назначение, порядок работы и границы защиты FoxBridge" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="О приложении" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="FoxBridge предоставляет локальный доступ к прокси Firefox VPN и подготавливает PowerShell для работы с CLI. Данные выбранного профиля Firefox используются для авторизации и получения доступных серверов.&#xA;&#xA;Это неофициальный клиент. Доступность сервиса и квота зависят от аккаунта Mozilla."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Принцип работы" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="Приложение открывает HTTP прокси на адресе 127.0.0.1 и выбранном порту. Запросы передаются через авторизованный сервер Firefox VPN. Для HTTPS используется туннель CONNECT. FoxBridge не расшифровывает содержимое HTTPS и не устанавливает сертификат для его перехвата.&#xA;&#xA;Системные настройки прокси и часовой пояс Windows сохраняются. Прокси действует для приложений, которым явно задан его адрес. В открытом через FoxBridge терминале адрес передаётся через переменные окружения. Программы должны поддерживать эти переменные."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Порядок работы" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="1. Войдите в нужный аккаунт Firefox и подготовьте доступ к Firefox VPN в этом профиле.&#xA;2. Выберите профиль во вкладке «Подключение» и нажмите «Загрузить профиль». Проверьте доступную квоту.&#xA;3. Выберите сервер и свободный локальный порт. Нажмите «Включить прокси».&#xA;4. Дождитесь проверки IP, оценки Net.Coffee и подготовки часового пояса. Изучите предупреждения во вкладке «Статистика».&#xA;5. Нажмите «Открыть защищённый терминал». Запускайте нужные CLI в открывшемся PowerShell.&#xA;6. По завершении остановите задачи, использующие прокси, и отключите подключение.&#xA;&#xA;Перед сменой сервера или профиля отключите прокси. Приложение запоминает порт, профиль и выбранный сервер. Подключение включается вручную. Если сохранённый сервер недоступен, выберите другой в списке. Сервер выбирается вручную. При восстановлении связи приложение использует выбранный сервер."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Защищённый терминал и часовой пояс" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="Кнопка открывает PowerShell с переменными прокси и TZ. Их наследуют дочерние процессы. Уже запущенные приложения сохраняют своё окружение. Поддержка прокси и TZ зависит от конкретной программы.&#xA;&#xA;Название «защищённый терминал» обозначает подготовленное окружение. Терминал не создаёт песочницу и не обеспечивает блокировку прямого доступа к сети. Программа, которая игнорирует переменные прокси, может подключаться напрямую.&#xA;&#xA;Часовой пояс берётся из ответа Net.Coffee. При отсутствии пояса используется приблизительное соответствие стране. Источник и предупреждение выводятся под кнопкой терминала. TZ не меняет часы Windows и не гарантирует совпадение всех признаков окружения с географией IP.&#xA;&#xA;Для Codex при поддержке установленной версией CLI применяется отдельный запуск с параметром отключения daemon. Если такой режим недоступен, терминал показывает предупреждение. Учитывайте его перед работой."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Статистика и оценка доверия" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="Проверка обращается через прокси к claude.ai и Net.Coffee. Net.Coffee получает проверяемый публичный IP. Вкладка «Статистика» показывает сетевые сведения, риски, географию, время проверки и ошибки источников.&#xA;&#xA;Зелёный цвет обозначает благоприятный результат, оранжевый обозначает предупреждение, красный обозначает риск. Справочные и неизвестные сведения отображаются нейтральным цветом. Для рисков применяются правила Net.Coffee. Приблизительный часовой пояс и ошибки источников дополнительно отмечаются предупреждениями FoxBridge.&#xA;&#xA;Оценка принадлежит Net.Coffee. Она не подтверждает доверие Anthropic и не гарантирует доступ к сервисам. После смены подключения нужна новая проверка. При ошибках или неполных данных изучите сообщения перед запуском терминала."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Трафик и квота" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="Остаток квоты поступает от Mozilla и относится к аккаунту. На него может влиять использование Firefox VPN в Firefox и на других устройствах этого аккаунта. Этот показатель не измеряет расход текущего запуска FoxBridge.&#xA;&#xA;В блоке «Активность» отображаются объёмы данных, переданных через локальный прокси в текущем подключении. Проверки IP тоже создают трафик. При отключении счётчики подключения сбрасываются. Данные квоты и локальные счётчики имеют разную область учёта и обновляются в разное время.&#xA;&#xA;Повторное включение прокси позволяет работающим программам снова обращаться к нему. Завершайте ненужные задачи в терминале, если хотите остановить их сетевую активность."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Требования к запуску" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="Windows x64 с поддержкой WinUI 3. Текущая сборка проверена на Windows 11.&#xA;.NET Runtime 10 x64.&#xA;Windows App Runtime 2.6.4 x64.&#xA;Python 3.12 или новее, доступный через PATH.&#xA;Профиль Firefox с действующей авторизацией и доступным Firefox VPN.&#xA;Доступ к сети, свободный локальный порт и право записи настроек в папку приложения.&#xA;&#xA;При запуске проверяются версия Python и наличие файлов ядра. Результат и ссылка на установку Python находятся в настройках. Если .NET или Windows App Runtime отсутствует, штатное окно установки появляется до запуска интерфейса.&#xA;&#xA;Сохраняйте все файлы рабочей сборки рядом с EXE, включая папку Backend. Текущая поставка использует установленные компоненты .NET, Windows App Runtime и Python. CLI устанавливаются отдельно.&#xA;&#xA;Для разработки дополнительно нужны .NET SDK 10, Windows SDK и средства сборки WinUI 3. Для обычного запуска эти средства разработки не требуются."/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Данные и предостережения" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource ReadmeText}" Text="Берегите профиль Firefox и данные авторизации. Не передавайте их вместе со сборкой. Локальные приложения с доступом к порту могут использовать включённый прокси и расходовать квоту.&#xA;&#xA;Журнал содержит события текущего запуска. Токены и содержимое пользовательских запросов в него не выводятся. Настройки пути к профилям сохраняются рядом с EXE в файле настроек интерфейса. Перед передачей папки приложения проверьте этот файл на личные пути.&#xA;&#xA;При закрытии FoxBridge локальный прокси останавливается. Открытый PowerShell может остаться запущенным со старым адресом прокси в окружении. Для нового подключения открывайте терминал из приложения заново.&#xA;&#xA;Соблюдайте условия Mozilla и сервисов, к которым обращаетесь. Учитывайте ограничения аккаунта, сети и региона. Приложение не гарантирует анонимность или отсутствие ограничений со стороны сервисов."/>
                    </StackPanel></Border>
                </StackPanel>
                <StackPanel x:Name="SettingsPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Настройки" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Компоненты приложения" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DependencyText" Text="Проверяем компоненты…" Style="{StaticResource Muted}" IsTextSelectionEnabled="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="DependencyCheckButton" Content="Повторить проверку" Click="CheckDependencies"/>
                            <HyperlinkButton Content="Скачать Python" NavigateUri="https://www.python.org/downloads/windows/"/>
                        </StackPanel>
                        <TextBlock Text="Если отсутствует .NET или Windows App Runtime, инструкция по установке появляется до открытия окна приложения." Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
                        <TextBlock Text="Профили Firefox" FontWeight="SemiBold"/>
                        <TextBox x:Name="ProfilesPathBox" Header="Путь к profiles.ini" PlaceholderText="Автоматически: %APPDATA%\Mozilla\Firefox\profiles.ini"/>
                        <TextBlock Text="Оставьте поле пустым для автоматического поиска. Перед сменой профиля отключите прокси." Style="{StaticResource Muted}"/>
                        <Button x:Name="SaveSettingsButton" Content="Указать вручную" Click="SaveSettings"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
                        <TextBlock Text="Оформление" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ThemeBox" Header="Тема приложения" SelectionChanged="ChangeTheme" SelectedIndex="0">
                            <ComboBoxItem Content="Тёмная"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Как в Windows"/>
                        </ComboBox>
                    </StackPanel></Border>
                    <TextBlock Text="FoxBridge · Локальный прокси" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>

