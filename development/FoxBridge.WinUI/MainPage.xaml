<Page x:Class="FoxBridge_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FoxBridge_WinUI">
    <Page.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <SolidColorBrush x:Key="StatisticGoodBrush" Color="#7DDEA5"/>
                <SolidColorBrush x:Key="StatisticWarningBrush" Color="#FFB56B"/>
                <SolidColorBrush x:Key="StatisticBadBrush" Color="#FF8E95"/>
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="StatisticGoodBrush" Color="#087A3D"/>
                <SolidColorBrush x:Key="StatisticWarningBrush" Color="#9A4B00"/>
                <SolidColorBrush x:Key="StatisticBadBrush" Color="#BB2537"/>
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="StatisticGood" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource StatisticGoodBrush}"/></Style>
        <Style x:Key="StatisticWarning" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource StatisticWarningBrush}"/></Style>
        <Style x:Key="StatisticBad" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource StatisticBadBrush}"/></Style>
        <Style x:Key="StatisticNeutral" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></Style>
        <Style x:Key="StatisticCell" TargetType="Border">
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        </Style>
        <Style x:Key="StatisticDivider" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,-20,0"/>
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <SolidColorBrush x:Key="FoxAccent" Color="#FFAA7B"/>
        <Style x:Key="QuotaIndicatorStyle" TargetType="local:QuotaIndicator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:QuotaIndicator">
                        <Grid Height="6">
                            <Border CornerRadius="3" Background="{ThemeResource ControlStrongFillColorDefaultBrush}"/>
                            <Border x:Name="Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ReadmeText" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="LineHeight" Value="23"/>
            <Setter Property="IsTextSelectionEnabled" Value="True"/>
        </Style>
      </ResourceDictionary>
    </Page.Resources>
    <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="190"
        ExpandedModeThresholdWidth="1000" CompactModeThresholdWidth="0"
        DisplayModeChanged="AdaptNavigation" PaneOpened="NavigationPaneOpened" PaneClosing="NavigationPaneClosing"
        IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="True"
        IsSettingsVisible="True" SelectionChanged="Navigate">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Подключение" Tag="dashboard" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Статистика" Tag="details"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Журнал" Tag="log"><NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem Content="Readme" Tag="readme"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;"/></NavigationViewItem.Icon></NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.PaneFooter>
            <StackPanel x:Name="NavigationFooter" Margin="16,0,12,22" Spacing="5" Visibility="Collapsed">
                <TextBlock Text="FIREFOX VPN" FontSize="10" CharacterSpacing="140" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Локальный мост" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </NavigationView.PaneFooter>
        <ScrollViewer x:Name="ContentScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" SizeChanged="AdaptPage">
            <Grid x:Name="PageRoot" Padding="28,14,28,28" MaxWidth="1200" HorizontalAlignment="Center"
                  Width="{Binding ViewportWidth, ElementName=ContentScroll}"
                  IsTabStop="True" UseSystemFocusVisuals="False" Background="Transparent"
                  PointerPressed="BackgroundPointerPressed">
                <Grid x:Name="Dashboard" ColumnSpacing="18" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="DashboardHeader" Grid.ColumnSpan="2" Spacing="18" Margin="0,0,0,18">
                    <TextBlock Text="Подключение" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <StackPanel x:Name="NoticesPanel" Spacing="8" Visibility="Collapsed">
                    <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" Severity="Warning" Closed="WarningClosed"/>
                    <InfoBar x:Name="AdminWarning" IsOpen="False" IsClosable="True" Severity="Warning"
                             Title="Запуск без прав администратора"
                             Message="TUN недоступен. Для подключения всего компьютера закройте FoxBridge и запустите его от имени администратора. Режим для CLI доступен." Closed="WarningClosed"/>
                    </StackPanel>
                    </StackPanel>
                    <Grid x:Name="ProfileCards" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,18" VerticalAlignment="Top" ColumnSpacing="18" RowSpacing="18" SizeChanged="AdaptProfileCards">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="ProfileCard" Style="{StaticResource Card}" Padding="20,16">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Профиль Firefox" FontWeight="SemiBold"/>
                            <Grid x:Name="ProfileControls" ColumnSpacing="12" RowSpacing="12" SizeChanged="AdaptProfileControls">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <ComboBox x:Name="ProfileBox" PlaceholderText="Поиск профилей…" SelectionChanged="ProfileChanged" HorizontalAlignment="Stretch"/>
                                <Button x:Name="LoadButton" Grid.Column="1" Content="Загрузить профиль" Click="LoadProfile"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border x:Name="QuotaCard" Grid.Column="1" Style="{StaticResource Card}" Padding="20,16"
                            ToolTipService.ToolTip="Квота Mozilla появится после загрузки профиля">
                        <StackPanel Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Осталось" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="QuotaValue" Text="…" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="QuotaUnit" Text="Нет данных" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <local:QuotaIndicator x:Name="QuotaBar" Height="6" Style="{StaticResource QuotaIndicatorStyle}"
                                                 Value="0" Maximum="100" Foreground="{StaticResource FoxAccent}"
                                                 AutomationProperties.Name="Остаток квоты Mozilla"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Grid x:Name="TopCards" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,18" ColumnSpacing="18" RowSpacing="18" SizeChanged="AdaptCards">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border x:Name="ConnectionCard" Style="{StaticResource Card}">
                            <StackPanel x:Name="ConnectionContent" Spacing="17">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#929292" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="Не подключено" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Ваш маршрут через Firefox" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="Сервер меняется только по вашему выбору" Style="{StaticResource Muted}"/>
                                </StackPanel>
                                <ComboBox x:Name="ServerBox" Header="Сервер" PlaceholderText="Сначала загрузите профиль Firefox" SelectionChanged="ServerChanged" HorizontalAlignment="Stretch" IsEnabled="False"/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="Локальный HTTP-прокси" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="AddressText" Text="127.0.0.1:8765" FontFamily="Consolas" FontSize="14"/>
                                    </StackPanel>
                                    <NumberBox x:Name="PortBox" Grid.Column="1" Header="Порт" Value="8765" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Hidden" ValueChanged="PortChanged"/>
                                </Grid>
                                <ComboBox x:Name="ModeBox" Header="Режим подключения" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ModeChanged">
                                    <ComboBoxItem Content="Отдельные приложения"/>
                                    <ComboBoxItem Content="Весь компьютер · TUN"/>
                                </ComboBox>
                                <TextBlock x:Name="ModeNote" Style="{StaticResource Muted}" FontSize="12"/>
                                <Button x:Name="ConnectButton" Content="Включить прокси" Click="ToggleConnection" HorizontalAlignment="Stretch" Height="44" IsEnabled="False" Style="{ThemeResource AccentButtonStyle}"/>
                                <Button x:Name="RetryButton" Content="Повторить подключение" Click="RetryConnection" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="RouteSideCards" Grid.Column="1" Spacing="18">
                        <Border x:Name="ScoreCard" Style="{StaticResource Card}">
                            <StackPanel x:Name="ScoreContent" Spacing="16">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Доверие к IP" FontWeight="SemiBold"/>
                                    <TextBlock Text="NET.COFFEE" FontSize="10" CharacterSpacing="110" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                    <TextBlock x:Name="ScoreText" Text="—" FontSize="64" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                    <TextBlock Text="/ 100" Style="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                                </StackPanel>
                                <ProgressBar x:Name="ScoreBar" Value="0" Maximum="100" Foreground="#9CA3AF"/>
                                <TextBlock x:Name="ScoreNote" Text="Оценка появится после подключения и проверки выходного IP." Style="{StaticResource Muted}" MinHeight="48"/>
                                <Button x:Name="RefreshStatsButton" Content="Обновить оценку" Click="RefreshStatistics" IsEnabled="False" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="Оценка Net.Coffee, не рейтинг Anthropic" Style="{StaticResource Muted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    <Border x:Name="TerminalCard" Style="{StaticResource Card}">
                        <StackPanel x:Name="TerminalContent" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE756;" Foreground="{StaticResource FoxAccent}" FontSize="18"/>
                                <TextBlock Text="Защищённые приложения" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Button x:Name="ShellButton" Click="OpenShell" IsEnabled="False" HorizontalAlignment="Stretch">
                                <TextBlock Text="Открыть защищённый терминал" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <Button x:Name="BrowserButton" Click="OpenBrowser" IsEnabled="False" HorizontalAlignment="Stretch">
                                <TextBlock x:Name="BrowserButtonText" Text="Открыть Firefox" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Button>
                            <TextBlock x:Name="LaunchNote" Text="Включите прокси и дождитесь оценки IP и подготовки часового пояса." Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DashboardFooter" Grid.Row="3" Grid.ColumnSpan="2" Text="Локальный прокси через Firefox VPN · Неофициальный клиент" Style="{StaticResource Muted}" FontSize="11" Margin="2,0,0,0"/>
                </Grid>
                <StackPanel x:Name="DetailsPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Статистика соединения" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="10"><TextBlock Text="Активность" FontWeight="SemiBold"/><TextBlock x:Name="ActivityText" Text="Прокси выключен" Style="{StaticResource Muted}"/><TextBlock x:Name="ChannelText" Text="Канал не запущен" Style="{StaticResource Muted}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Последняя проверка" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailsStateText" Text="Данных пока нет. Подключитесь и обновите оценку." Style="{StaticResource Muted}"/>
                            <Grid x:Name="StatisticRows" ColumnSpacing="40" SizeChanged="AdaptStatistics">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="LogPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Журнал" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock Text="События текущего запуска. Токены и содержимое запросов сюда не попадают." Style="{StaticResource Muted}"/>
                    <Border Style="{StaticResource Card}"><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MinHeight="300" BorderThickness="0" Background="Transparent"/></Border>
                </StackPanel>
                <StackPanel x:Name="ReadmePanel" Spacing="18" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Readme и FAQ" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Текущие возможности, порядок работы и ответы на вопросы" Style="{StaticResource Muted}"/>
                    </StackPanel>
                    <StackPanel x:Name="ReadmeSections" Spacing="18"/>
                </StackPanel>
                <StackPanel x:Name="SettingsPanel" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Настройки" Style="{ThemeResource TitleTextBlockStyle}"/>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="12">
                        <TextBlock Text="Компоненты приложения" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DependencyText" Text="Проверяем компоненты…" Style="{StaticResource Muted}" IsTextSelectionEnabled="True"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="DependencyCheckButton" Content="Повторить проверку" Click="CheckDependencies"/>
                        </StackPanel>
                        <TextBlock Text="Если отсутствует .NET или Windows App Runtime, инструкция по установке появляется до открытия окна приложения." Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
                        <TextBlock Text="Профили Firefox" FontWeight="SemiBold"/>
                        <TextBox x:Name="ProfilesPathBox" Header="Путь к profiles.ini" PlaceholderText="Автоматически: %APPDATA%\Mozilla\Firefox\profiles.ini"/>
                        <TextBlock Text="Оставьте поле пустым для автоматического поиска. Перед сменой профиля отключите прокси." Style="{StaticResource Muted}"/>
                        <Button x:Name="SaveSettingsButton" Content="Указать вручную" Click="SaveSettings"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="16">
                        <TextBlock Text="Оформление" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ThemeBox" Header="Тема приложения" SelectionChanged="ChangeTheme" SelectedIndex="0">
                            <ComboBoxItem Content="Тёмная"/><ComboBoxItem Content="Светлая"/><ComboBoxItem Content="Как в Windows"/>
                        </ComboBox>
                    </StackPanel></Border>
                    <TextBlock Text="FoxBridge · Локальный прокси" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>

